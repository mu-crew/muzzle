#!/usr/bin/env node

const { spawn } = require("node:child_process");

const packages = {
  "linux-x64": "@mu-crew/muzzle-linux-x64",
  "linux-arm64": "@mu-crew/muzzle-linux-arm64",
  "darwin-arm64": "@mu-crew/muzzle-darwin-arm64",
};
const platform = `${process.platform}-${process.arch}`;
const packageName = packages[platform];

if (!packageName) {
  console.error(
    `muzzle: unsupported platform ${platform}; supported platforms: ${Object.keys(packages).join(", ")}`,
  );
  process.exit(1);
}

let binary;
try {
  binary = require.resolve(`${packageName}/bin/muzzle`);
} catch {
  console.error(
    `muzzle: could not find ${packageName}; reinstall @mu-crew/muzzle for ${platform}`,
  );
  process.exit(1);
}

// D16: muzzle must be the process pi (or a shell) put at the head of the
// group, or it moves the job to a group of its own and a SIGKILL of the
// original group leaks the job and its slots. execve replaces node with
// muzzle in place, keeping the pid and the group. Node >= 22.15 / 23.11.
if (typeof process.execve === "function") {
  try {
    process.execve(binary, [binary, ...process.argv.slice(2)], process.env);
  } catch {
    // fall through to spawn, which reports the error
  }
}

// Older Node: run muzzle as a child and forward signals. A group SIGKILL
// still leaks the job here.
const child = spawn(binary, process.argv.slice(2), { stdio: "inherit" });
const signals = ["SIGINT", "SIGTERM", "SIGHUP"];
for (const signal of signals) {
  process.on(signal, () => child.kill(signal));
}
child.on("error", (error) => {
  console.error(`muzzle: failed to run ${binary}: ${error.message}`);
  process.exit(1);
});
child.on("exit", (code, signal) => {
  if (signal) {
    for (const handledSignal of signals) process.removeAllListeners(handledSignal);
    process.kill(process.pid, signal);
  } else {
    process.exit(code ?? 1);
  }
});
