#!/usr/bin/env python3
"""Validate benchmark traces before they are committed (spec D37-D40,
§Interface "Trace format").

    bench/check-trace [--labels FILE] [TRACE.jsonl | - ...]

With no TRACE, checks every file under bench/traces/, recursively. `-` reads
stdin (the pre-commit hook pipes the staged blob). `--paths REL ...` checks
only that each path, relative to bench/traces/, may be published there (the
hook runs it on every staged path).

Git publishes file names as well as contents, so every path under
bench/traces/ must be `YYYY-MM-DD(-[a-z0-9]{1,16})?.jsonl` or the top-level
`.gitkeep`, with no subdirectories; a suffix holding the user name is
refused too. A refused path is never echoed: it may be the leak itself. Exit 0 when every trace passes, 1
otherwise. Errors name the line, the field and the kind of problem, never
the offending value, so a leaked token doesn't land in a CI log.

Every string must come from a label list: the fixed ones below, or the
`rule NAME` / `project NAME` lines of bench/allowed-labels.txt, so adding a
publishable label is a reviewed commit. The leak patterns run first, over
every key and string, so a bad trace says *why* it is bad.

The published file is the raw text, so the checks must see exactly what is
published: a duplicate key is refused (json.loads would keep only the last
value and check that), and every line must equal its canonical
re-serialisation, which closes any other parser-differential trick.
Numbers are bounded and kept to 3 decimals so they can't carry text.
"""

from __future__ import annotations

import argparse
import getpass
import json
import math
import re
import sys
from datetime import date
from pathlib import Path

BENCH = Path(__file__).resolve().parent
HOST = "linuxpc"  # D37: the only host a trace may name.

HEADER_KEYS = {
    "v", "kind", "host", "cores", "ram_gb", "date", "window_s", "source",
    "calls_total", "calls_kept", "calls_dropped",
}  # fmt: skip
CALL_KEYS = {"v", "kind", "t", "dur_s", "dur_src", "bg", "rule", "role", "agent", "project"}
SOURCES = {"museum", "synthetic"}
DUR_SRCS = {"durationMs", "estimated"}
ROLES = {"orchestrator", "worker", "reviewer", "other"}
FIXED_RULES = {"unmatched-heavy", "light"}
AGENT = re.compile(r"a[1-9][0-9]*")
PROJECT = re.compile(r"p[1-9][0-9]*")
DATE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
# What a label in allowed-labels.txt may look like: short, lowercase, no
# separators that could carry a path or a host.
LABEL = re.compile(r"[a-z0-9][a-z0-9_-]{0,31}")
# The only publishable names under bench/traces/ (D40): too narrow for an
# email, a token or a host (no `.`, `@` or `_`, at most 16 suffix chars).
TRACE_NAME = re.compile(r"([0-9]{4}-[0-9]{2}-[0-9]{2})(?:-([a-z0-9]{1,16}))?\.jsonl")
NAME_RULE = "YYYY-MM-DD(-[a-z0-9]{1,16})?.jsonl"
# Number bounds: generous for any real machine and day, too tight to smuggle
# text (a 33-byte name as an integer is ~10^79).
MAX_CORES = 1024
MAX_RAM_GB = 4096
MAX_WINDOW_S = 7 * 86400
MAX_CALLS = 10**7

# Leak patterns (D40), checked in order; the first hit names the problem.
# Token patterns follow gitleaks' common rules plus long hex/base64 runs.
LEAKS = [
    ("home dir", re.compile(r"^~|(^|/)(home|Users|var/home)/")),
    ("path", re.compile(r"[/\\]")),
    ("email", re.compile(r"[^@\s]+@[^@\s]+\.[A-Za-z]{2,}")),
    (
        "token",
        re.compile(
            r"AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_|glpat-|"
            r"xox[abprs]-|sk-[A-Za-z0-9_-]{16,}|-----BEGIN|eyJ[A-Za-z0-9_-]{8,}\.|"
            r"[0-9a-fA-F]{32,}|[A-Za-z0-9+/_=-]{40,}"
        ),
    ),
    ("hostname", re.compile(r"[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+|\.local$|\.lan$")),
]


def load_labels(path: Path) -> tuple[set[str], set[str], list[str]]:
    """(rules, projects, errors) from an allowed-labels file."""
    rules: set[str] = set()
    projects: set[str] = set()
    errors = []
    try:
        lines = path.read_text().splitlines()
    except OSError as e:
        return rules, projects, [f"{path}: cannot read labels: {e.strerror}"]
    for n, line in enumerate(lines, 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        kind, _, name = line.partition(" ")
        name = name.strip()
        if kind not in ("rule", "project") or not LABEL.fullmatch(name):
            errors.append(f"{path}:{n}: want `rule NAME` or `project NAME`, NAME [a-z0-9_-]")
        elif kind == "project" and PROJECT.fullmatch(name):
            errors.append(f"{path}:{n}: a kept project can't look like p<digits>")
        else:
            (rules if kind == "rule" else projects).add(name)
    return rules, projects, errors


def leak(s: str, users: set[str]) -> str | None:
    for kind, pattern in LEAKS:
        if pattern.search(s):
            return kind
    # A bare user name is a home-dir leak without the path around it, and
    # the allowlist alone wouldn't stop it as a kept project name.
    if any(u in s.lower() for u in users):
        return "home dir"
    return None


def trace_file_ok(name: str) -> bool:
    """Whether NAME may name a published trace (D40)."""
    m = TRACE_NAME.fullmatch(name)
    if not m:
        return False
    try:
        date.fromisoformat(m[1])
    except ValueError:
        return False
    return not (m[2] and leak(m[2], user_names()))


def trace_path_ok(rel: str) -> bool:
    """Whether REL, relative to bench/traces/, may be committed there."""
    return rel == ".gitkeep" or trace_file_ok(rel)


def bad_paths_error(n: int) -> str:
    return (
        f"bench/traces/ has {n} path(s) not named {NAME_RULE} or the top-level "
        ".gitkeep (no subdirectories); names withheld (D40)"
    )


def user_names() -> set[str]:
    names = {getpass.getuser(), Path.home().name}
    return {n.lower() for n in names if len(n) >= 3}


def strings(v: object, where: str = "a value"):
    """Every key and string inside a JSON value, with where it sits."""
    if isinstance(v, dict):
        for k, x in v.items():
            yield "a key", k
            yield from strings(x, repr(k))
    elif isinstance(v, list):
        for x in v:
            yield from strings(x, where)
    elif isinstance(v, str):
        yield where, v


def is_int(v: object) -> bool:
    return isinstance(v, int) and not isinstance(v, bool)


def is_num(v: object) -> bool:
    return (isinstance(v, (int, float)) and not isinstance(v, bool)) and math.isfinite(v)


def is_ms(v: object) -> bool:
    """A finite number with at most 3 decimals, as from-museum rounds."""
    return is_num(v) and round(v, 3) == v


def int_in(v: object, lo: int, hi: int) -> bool:
    return is_int(v) and lo <= v <= hi


def check_header(h: dict, err) -> None:
    for k in sorted(set(h) - HEADER_KEYS):
        err(f"field {k!r} not allowed in the header")
    for k in sorted(HEADER_KEYS - set(h)):
        err(f"header misses {k!r}")
    if h.get("v") != 1:
        err("v must be 1")
    if "host" in h and h["host"] != HOST:
        err(f"foreign host in 'host': only {HOST} traces are allowed (D37)")
    for k, lo, hi in (
        ("cores", 1, MAX_CORES),
        ("ram_gb", 1, MAX_RAM_GB),
        ("window_s", 1, MAX_WINDOW_S),
        ("calls_total", 0, MAX_CALLS),
        ("calls_kept", 0, MAX_CALLS),
        ("calls_dropped", 0, MAX_CALLS),
    ):
        if k in h and not int_in(h[k], lo, hi):
            err(f"{k!r} must be an integer in [{lo}, {hi}]")
    if "date" in h:
        d = h["date"]
        try:
            ok = isinstance(d, str) and DATE.fullmatch(d) and date.fromisoformat(d)
        except ValueError:
            ok = False
        if not ok:
            err("'date' must be YYYY-MM-DD")
    if "source" in h and not (isinstance(h["source"], str) and h["source"] in SOURCES):
        err("free text in 'source'")
    counts = [h.get(k) for k in ("calls_total", "calls_kept", "calls_dropped")]
    if all(is_int(c) for c in counts) and counts[0] != counts[1] + counts[2]:
        err("calls_total must equal calls_kept + calls_dropped")


def check_call(c: dict, window: object, rules: set[str], projects: set[str], err) -> None:
    for k in sorted(set(c) - CALL_KEYS):
        err(f"field {k!r} not allowed in a call")
    for k in sorted(CALL_KEYS - set(c)):
        err(f"call misses {k!r}")
    if c.get("v") != 1:
        err("v must be 1")
    # An invalid header window is reported there; bound by the maximum.
    window = window if int_in(window, 1, MAX_WINDOW_S) else MAX_WINDOW_S
    if "t" in c and not (is_ms(c["t"]) and 0 <= c["t"] < window):
        err("'t' must be a number in [0, window_s) with at most 3 decimals")
    if "dur_s" in c and not (is_ms(c["dur_s"]) and 0 <= c["dur_s"] <= window):
        err("'dur_s' must be a number in [0, window_s] with at most 3 decimals")
    if "bg" in c and not isinstance(c["bg"], bool):
        err("'bg' must be true or false")
    for k, allowed in (("dur_src", DUR_SRCS), ("role", ROLES), ("rule", FIXED_RULES | rules)):
        # Type first: a dict or list isn't hashable, so `in` would raise.
        if k in c and not (isinstance(c[k], str) and c[k] in allowed):
            err(f"free text in {k!r}: not a known label")
    if "agent" in c and not (isinstance(c["agent"], str) and AGENT.fullmatch(c["agent"])):
        err("free text in 'agent': want a<digits>")
    if "project" in c:
        p = c["project"]
        if not (isinstance(p, str) and (PROJECT.fullmatch(p) or p in projects)):
            err("free text in 'project': want p<digits> or a kept name")


def reject_constant(name: str):
    raise ValueError(f"{name} is not valid JSON")


class DuplicateKey(ValueError):
    pass


def unique_keys(pairs: list) -> dict:
    seen: dict = {}
    for k, v in pairs:
        if k in seen:
            # Name only schema keys: any other key may be the leak itself.
            raise DuplicateKey(f"duplicate key {k!r}" if k in HEADER_KEYS | CALL_KEYS else "duplicate key")
        seen[k] = v
    return seen


def canonical(row: object) -> str:
    return json.dumps(row, separators=(",", ":"))


def check(name: str, text: str, rules: set[str], projects: set[str]) -> list[str]:
    errors: list[str] = []
    users = user_names()
    lines = text.splitlines()
    if not lines:
        return [f"{name}: empty trace, want a header line"]
    header: dict = {}
    calls = 0
    for n, line in enumerate(lines, 1):

        def err(msg: str, n: int = n) -> None:
            errors.append(f"{name}:{n}: {msg}")

        try:
            row = json.loads(line, parse_constant=reject_constant, object_pairs_hook=unique_keys)
        except DuplicateKey as e:
            err(str(e))
            continue
        except ValueError:
            err("not a JSON line")
            continue
        if canonical(row) != line:
            err("not canonical: want json.dumps(row, separators=(',', ':'))")
            continue
        if not isinstance(row, dict):
            err("not a JSON object")
            continue
        for where, s in strings(row):
            kind = leak(s, users)
            if kind:
                err(f"{kind} in {where}")
        kind = row.get("kind")
        if n == 1:
            if kind != "header":
                err("line 1 must be the header")
                continue
            header = row
            check_header(row, err)
        elif kind == "call":
            calls += 1
            check_call(row, header.get("window_s"), rules, projects, err)
        else:
            err("kind must be 'call' after the header")
    if is_int(header.get("calls_kept")) and header["calls_kept"] != calls:
        errors.append(f"{name}:1: calls_kept says {header['calls_kept']}, file has {calls}")
    return errors


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="check-trace", description=__doc__.split("\n\n")[0])
    p.add_argument("traces", nargs="*", help="trace files, or - for stdin")
    p.add_argument("--labels", type=Path, default=BENCH / "allowed-labels.txt")
    p.add_argument("--name", help="the name to report for stdin")
    p.add_argument("--paths", action="store_true", help="check TRACES as paths under bench/traces/ only")
    ns = p.parse_args(argv)
    if ns.paths:
        bad = sum(not trace_path_ok(t) for t in ns.traces)
        if bad:
            print(f"check-trace: {bad_paths_error(bad)}", file=sys.stderr)
        return 1 if bad else 0
    rules, projects, errors = load_labels(ns.labels)
    traces = ns.traces
    if not traces:
        # CI's mode: every path under traces/, so a nested, misnamed or
        # identifying one can't slip past (D40).
        root = BENCH / "traces"
        bad = links = 0
        for f in sorted(root.rglob("*")):
            rel = f.relative_to(root).as_posix()
            # Before is_file()/is_dir(), which follow the link: git
            # publishes the link's target text, not what it points at.
            if f.is_symlink():
                links += 1
            elif f.is_dir() or not trace_path_ok(rel):
                bad += 1
            elif rel == ".gitkeep":
                continue
            elif f.is_file():
                traces.append(str(f))
            else:
                errors.append(f"{f}: not a regular file")
        if bad:
            errors.append(bad_paths_error(bad))
        if links:
            errors.append(
                f"bench/traces/ has {links} symlink(s); git would publish the link "
                "target, so only regular files are allowed; names withheld (D40)"
            )
    for t in traces:
        if t == "-":
            errors += check(ns.name or "<stdin>", sys.stdin.read(), rules, projects)
            continue
        try:
            text = Path(t).read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as e:
            errors.append(f"{t}: cannot read: {e}")
            continue
        errors += check(t, text, rules, projects)
    for e in errors:
        print(f"check-trace: {e}", file=sys.stderr)
    if not errors:
        print(f"check-trace: {len(traces)} trace(s) ok")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
